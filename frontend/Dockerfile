FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_USER_MANAGEMENT_URL
ARG NEXT_PUBLIC_PERSONAL_ADMIN_URL
ARG NEXT_PUBLIC_SYSTEM_ADMIN_URL
ARG NEXT_PUBLIC_OPPORTUNITY_SERVICE_URL
ARG NEXT_PUBLIC_SCOUT_AGENT_URL
ARG NEXT_PUBLIC_RELOCATION_AGENT_URL
ARG NEXT_PUBLIC_APPLICATION_COACH_AGENT_URL
ENV NEXT_PUBLIC_USER_MANAGEMENT_URL=$NEXT_PUBLIC_USER_MANAGEMENT_URL
ENV NEXT_PUBLIC_PERSONAL_ADMIN_URL=$NEXT_PUBLIC_PERSONAL_ADMIN_URL
ENV NEXT_PUBLIC_SYSTEM_ADMIN_URL=$NEXT_PUBLIC_SYSTEM_ADMIN_URL
ENV NEXT_PUBLIC_OPPORTUNITY_SERVICE_URL=$NEXT_PUBLIC_OPPORTUNITY_SERVICE_URL
ENV NEXT_PUBLIC_SCOUT_AGENT_URL=$NEXT_PUBLIC_SCOUT_AGENT_URL
ENV NEXT_PUBLIC_RELOCATION_AGENT_URL=$NEXT_PUBLIC_RELOCATION_AGENT_URL
ENV NEXT_PUBLIC_APPLICATION_COACH_AGENT_URL=$NEXT_PUBLIC_APPLICATION_COACH_AGENT_URL
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["npm", "start"]
